# Copia este archivo a .env y completa los valores reales.
# NUNCA commitees el archivo .env real (ver .gitignore).

# --- Base de datos ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app_cobranza?schema=public"

# --- Reintentos de conexión TypeORM (opcional) ---
# El setup de e2e (test/e2e/setup.ts) los baja a 1 intento/500ms para fallar rápido
# si la BD no está disponible. En runtime se usan los defaults (10 intentos x 3s).
# TYPEORM_RETRY_ATTEMPTS="10"
# TYPEORM_RETRY_DELAY="3000"

# --- App ---
NODE_ENV="development"
PORT=3000

# --- Uploads locales (evidencias de gastos, MVP local) ---
# Carpeta donde se guardan las evidencias. Default: <cwd>/uploads/gastos.
UPLOAD_DIR="uploads/gastos"

# --- Uploads locales de fotos de cliente (MVP local) ---
# Carpeta donde se guardan las fotos facial/documento. Default: <cwd>/uploads/clientes.
UPLOAD_DIR_CLIENTES="uploads/clientes"

# --- Autenticación (HU-01) ---
JWT_SECRET=""
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET=""
JWT_REFRESH_EXPIRES_IN="7d"

# --- Bootstrap del primer administrador (seed) ---
# Usuario y contraseña iniciales que el seed crea si la tabla admin_users está vacía.
ADMIN_INITIAL_USERNAME=""
ADMIN_INITIAL_PASSWORD=""

# --- Data de prueba (desarrollo local, nunca producción) ---
# Si es "true", el TestDataSeedService carga datos sintéticos (prefijos test-)
# idempotentes para pruebas visuales del panel. Requiere un admin activo.
SEED_TEST_DATA="false"

# --- OpenCode MCP servers (usados solo por el agente de IA, no por la app) ---
CONTEXT7_API_KEY=""
GITHUB_TOKEN=""

# --- Fase 2 en adelante (Piloto controlado) — NO requeridos para el MVP local ---
# WHATSAPP_CLOUD_API_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
# GOOGLE_MAPS_API_KEY=""
# ANTHROPIC_API_KEY=""
