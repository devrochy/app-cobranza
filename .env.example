# Copia este archivo a .env y completa los valores reales.
# NUNCA commitees el archivo .env real (ver .gitignore).

# --- Base de datos ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app_cobranza?schema=public"

# --- App ---
NODE_ENV="development"
PORT=3000
JWT_SECRET=""
JWT_EXPIRES_IN="15m"

# --- OpenCode MCP servers (usados solo por el agente de IA, no por la app) ---
CONTEXT7_API_KEY=""
GITHUB_TOKEN=""

