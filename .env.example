# Copia este archivo a .env y completa los valores reales.
# NUNCA commitees el archivo .env real (ver .gitignore).

# --- Base de datos ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app_cobranza?schema=public"

# --- App ---
NODE_ENV="development"
PORT=3000

# --- Autenticación (HU-01) ---
JWT_SECRET=""
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET=""
JWT_REFRESH_EXPIRES_IN="7d"

# --- Bootstrap del primer administrador (seed) ---
# Usuario y contraseña iniciales que el seed crea si la tabla admin_users está vacía.
ADMIN_INITIAL_USERNAME=""
ADMIN_INITIAL_PASSWORD=""

# --- OpenCode MCP servers (usados solo por el agente de IA, no por la app) ---
CONTEXT7_API_KEY=""
GITHUB_TOKEN=""

# --- Fase 2 en adelante (Piloto controlado) — NO requeridos para el MVP local ---
# WHATSAPP_CLOUD_API_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
# GOOGLE_MAPS_API_KEY=""
# ANTHROPIC_API_KEY=""
